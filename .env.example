# Neon Postgres — pooled/HTTP connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/license_webapp?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me"

# Bearer token the cron route requires — generate with: openssl rand -base64 32
CRON_SECRET="dev-only-change-me"

# Resend — https://resend.com/api-keys (leave unset in dev; sends are skipped)
RESEND_API_KEY=""

# Optional override for the From address in src/server/mail/send.ts (defaults
# to "License Alerts <pattapon@mat.co.th>"). Useful for Resend's sandbox
# sender ("License Alerts <onboarding@resend.dev>") before a custom domain is
# DKIM/SPF-verified — sandbox mode only delivers to your own Resend account
# email, though, so it proves the API key works without proving real delivery.
RESEND_FROM_ADDRESS=""

# Google AI Studio — https://aistudio.google.com/apikey (leave unset to disable AI features)
GEMINI_API_KEY=""

# --- Monitoring (optional in dev; set BOTH in production) ---------------------
# The app can report its own errors but cannot report *not running* — if the
# cron stops firing there is no request, no log and no row to notice. These two
# cover the gap, and they cover different failures: the heartbeat catches "the
# job never ran", the ops email catches "the job ran but couldn't deliver".

# Ping URL from healthchecks.io / Better Stack / Cronitor. Create a check that
# expects a ping every 24h with ~1h grace; that service emails you when the
# alerter goes quiet. A "/fail" suffix is appended automatically on a bad run.
HEARTBEAT_URL=""

# Who to email when a run finishes with errors. Requires RESEND_API_KEY to be
# set as well, or the notification is only logged to the console.
OPS_ALERT_EMAIL=""
