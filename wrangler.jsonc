{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "license-webapp",
  // Generated by `opennextjs-cloudflare build` — do not point this at src/.
  "main": ".open-next/worker.js",
  // >= 2024-09-23 is required for nodejs_compat v2; a recent date also makes
  // workerd auto-populate process.env from vars/secrets, which getEnv() relies on.
  "compatibility_date": "2026-08-21",
  // Enables Buffer, process.env, node: imports and CommonJS require() — needed
  // by bcryptjs, ExcelJS, and src/lib/env.ts (process.env). Without this the
  // Worker build fails on those Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  // Static assets emitted by the OpenNext build.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // Secrets (set with `wrangler secret put <NAME>`, never commit them):
  //   DATABASE_URL, AUTH_SECRET, CRON_SECRET,
  //   RESEND_API_KEY, GEMINI_API_KEY, HEARTBEAT_URL, OPS_ALERT_EMAIL
  // Optional: AUTH_URL = the deployed https://<worker>.workers.dev origin.
  //
  // Cron is NOT defined here — it lives in cron-worker/ as a separate Worker
  // that calls this app's /api/cron/daily route. See cron-worker/wrangler.jsonc.
}
